    },
    "what_is_keycard": {
      "question": {
        "translation": "À quoi sert Keycard ?",
        "notes": "faqs::what_is_keycard::question"
      },
      "answer": {
        "translation": "Keycard est un portefeuille matériel sécurisé pour stocker et gérer vos cryptomonnaies.",
        "notes": "faqs::what_is_keycard::answer"
      }
    },
    "which_assets": {
      "question": {
        "translation": "Quels actifs Keycard prend‑elle en charge ?",
        "notes": "faqs::which_assets::question"
      },
      "answer": {
        "translation": "Keycard fonctionne de manière fluide avec Ethereum et les actifs basés sur EVM. Elle prend en charge",
        "notes": "faqs::which_assets::answer"
      },
      "link_text": {
        "translation": "liste de jetons par défaut d’Uniswap Labs",
        "notes": "faqs::which_assets::link_text"
      },
      "answer_text": {
        "translation": "Keycard fonctionne de manière fluide avec Ethereum et les actifs basés sur EVM. Elle prend en charge tous les actifs de la liste de jetons par défaut d’Uniswap Labs.",
        "notes": "faqs::which_assets::answer_text"
      }
    },
    "funds_safe": {
      "question": {
        "translation": "Mes fonds sont‑ils en sécurité si je perds ma Keycard ?",
        "notes": "faqs::funds_safe::question"
      },
      "answer": {
        "translation": "Oui, vos fonds sont en sécurité. Vous pouvez récupérer vos actifs à l’aide de votre phrase de récupération de sauvegarde.",
        "notes": "faqs::funds_safe::answer"
      }
    },
    "wallets_support": {
      "question": {
        "translation": "Quels portefeuilles prennent en charge Keycard ?",
        "notes": "faqs::wallets_support::question"
      },
      "answer": {
        "translation": "Keycard est compatible avec plusieurs portefeuilles logiciels. Veuillez consulter notre documentation pour la liste complète.",
        "notes": "faqs::wallets_support::answer"
      }
    },
    "why_get_keycard": {
      "question": {
        "translation": "Pourquoi devrais‑je utiliser une Keycard ?",
        "notes": "faqs::why_get_keycard::question"
      },
      "answer": {
        "translation": "Keycard est un portefeuille matériel sécurisé au format de poche, doté d’une puce authentique et immuable pour protéger vos actifs numériques.",
        "notes": "faqs::why_get_keycard::answer"
      }
    }
  },
