  "faqs": {
    "title": {
      "translation": "자주 묻는 질문",
      "notes": "faqs::title"
    },
    "what_is_keycard": {
      "question": {
        "translation": "키카드는 무엇을 위한 것인가요?",
        "notes": "faqs::what_is_keycard::question"
      },
      "answer": {
        "translation": "키카드는 암호화폐를 저장하고 관리하기 위한 안전한 하드웨어 지갑입니다.",
        "notes": "faqs::what_is_keycard::answer"
      }
    },
    "which_assets": {
      "question": {
        "translation": "키카드는 어떤 자산을 지원하나요?",
        "notes": "faqs::which_assets::question"
      },
      "answer": {
        "translation": "키카드는 이더리움 및 EVM 기반 자산과 원활하게 작동합니다. 지원합니다",
        "notes": "faqs::which_assets::answer"
      },
      "link_text": {
        "translation": "Uniswap Labs 기본 토큰 목록",
        "notes": "faqs::which_assets::link_text"
      },
      "answer_text": {
        "translation": "키카드는 이더리움 및 EVM 기반 자산과 원활하게 작동합니다. Uniswap Labs 기본 토큰 목록의 모든 자산을 지원합니다.",
        "notes": "faqs::which_assets::answer_text"
      }
    },
    "funds_safe": {
      "question": {
        "translation": "키카드를 잃어버리면 자금이 안전한가요?",
        "notes": "faqs::funds_safe::question"
      },
      "answer": {
        "translation": "네, 자금은 안전합니다. 백업 시드 구문을 사용하여 자산을 복구할 수 있습니다.",
        "notes": "faqs::funds_safe::answer"
      }
    },
    "wallets_support": {
      "question": {
        "translation": "어떤 지갑이 키카드를 지원하나요?",
        "notes": "faqs::wallets_support::question"
      },
      "answer": {
        "translation": "키카드는 다양한 소프트웨어 지갑과 호환됩니다. 전체 목록은 문서를 확인해 주세요.",
        "notes": "faqs::wallets_support::answer"
      }
    },
    "why_get_keycard": {
      "question": {
        "translation": "왜 키카드를 구매해야 하나요?",
        "notes": "faqs::why_get_keycard::question"
      },
      "answer": {
        "translation": "키카드는 디지털 자산을 보호하는 입증 가능한 진품의 불변 칩을 가진 안전하고 휴대하기 쉬운 하드웨어 지갑입니다.",
        "notes": "faqs::why_get_keycard::answer"
      }
    }
  },
