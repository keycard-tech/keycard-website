  "faqs": {
    "title": {
      "translation": "Preguntas frecuentes",
      "notes": "faqs::title"
    },
    "what_is_keycard": {
      "question": {
        "translation": "¿Para qué sirve Keycard?",
        "notes": "faqs::what_is_keycard::question"
      },
      "answer": {
        "translation": "Keycard es una hardware wallet segura para almacenar y gestionar tus criptomonedas.",
        "notes": "faqs::what_is_keycard::answer"
      }
    },
    "which_assets": {
      "question": {
        "translation": "¿Qué activos admite Keycard?",
        "notes": "faqs::which_assets::question"
      },
      "answer": {
        "translation": "Keycard funciona de forma fluida con Ethereum y activos basados en EVM. Es compatible con",
        "notes": "faqs::which_assets::answer"
      },
      "link_text": {
        "translation": "lista de tokens predeterminada de Uniswap Labs",
        "notes": "faqs::which_assets::link_text"
      },
      "answer_text": {
        "translation": "Keycard funciona de forma fluida con Ethereum y activos basados en EVM. Es compatible con todos los activos de la lista de tokens predeterminada de Uniswap Labs.",
        "notes": "faqs::which_assets::answer_text"
      }
    },
    "funds_safe": {
      "question": {
        "translation": "¿Mis fondos están seguros si pierdo mi Keycard?",
        "notes": "faqs::funds_safe::question"
      },
      "answer": {
        "translation": "Sí, tus fondos están seguros. Puedes recuperar tus activos utilizando tu frase semilla de copia de seguridad.",
        "notes": "faqs::funds_safe::answer"
      }
    },
    "wallets_support": {
      "question": {
        "translation": "¿Qué monederos son compatibles con Keycard?",
        "notes": "faqs::wallets_support::question"
      },
      "answer": {
        "translation": "Keycard es compatible con varios monederos de software. Consulta nuestra documentación para ver la lista completa.",
        "notes": "faqs::wallets_support::answer"
      }
    },
    "why_get_keycard": {
      "question": {
        "translation": "¿Por qué debería conseguir una Keycard?",
        "notes": "faqs::why_get_keycard::question"
      },
      "answer": {
        "translation": "Keycard es una hardware wallet segura de tamaño de bolsillo con un chip demostrablemente auténtico e inmutable para proteger tus activos digitales.",
        "notes": "faqs::why_get_keycard::answer"
      }
    }
  },
