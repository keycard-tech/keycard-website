      "answer_text": {
        "translation": "Keycard works seamlessly with Ethereum and EVM based assets. It supports all assets on Uniswap Labs default token list.",
        "notes": "faqs::which_assets::answer_text"
      }
    },
    "funds_safe": {
      "question": {
        "translation": "Are my funds safe if I lose my Keycard?",
        "notes": "faqs::funds_safe::question"
      },
      "answer": {
        "translation": "Yes, your funds are safe. You can recover your assets using your backup seed phrase.",
        "notes": "faqs::funds_safe::answer"
      }
    },
    "wallets_support": {
      "question": {
        "translation": "What wallets support Keycard?",
        "notes": "faqs::wallets_support::question"
      },
      "answer": {
        "translation": "Keycard is compatible with various software wallets. Please check our documentation for a full list.",
        "notes": "faqs::wallets_support::answer"
      }
    },
    "why_get_keycard": {
      "question": {
        "translation": "Why should I get a Keycard?",
        "notes": "faqs::why_get_keycard::question"
      },
      "answer": {
        "translation": "Keycard is a secure, pocket-sized hardware wallet with a provably genuine, immutable chip to protect your digital assets.",
        "notes": "faqs::why_get_keycard::answer"
      }
    }
