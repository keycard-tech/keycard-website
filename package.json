{
  "name": "keycard-website",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "predev": "pnpm install",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write . --ignore-path .gitignore",
    "check": "tsc --noEmit",
    "env:check": "node -r dotenv/config ./src/config/env.server.mjs dotenv_config_path=./.env && node -r dotenv/config ./src/config/env.client.mjs dotenv_config_path=./.env && :",
    "clean": "rimraf .next .vercel/output node_modules",
    "test:legal-redirects": "node scripts/test-legal-redirects.mjs",
    "seo:check": "node scripts/seo-check-legacy-urls.mjs"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.6.1",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@react-three/drei": "^9.117.2",
    "@react-three/fiber": "9.0.0-rc.1",
    "@react-three/postprocessing": "^2.16.3",
    "@status-im/icons": "^1.0.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tanstack/react-query": "^5.59.17",
    "@tryghost/content-api": "^1.11.21",
    "@types/three": "^0.170.0",
    "@types/unist": "^3.0.3",
    "@vercel/analytics": "^1.4.1",
    "cva": "1.0.0-beta.1",
    "d3-time-format": "^4.1.0",
    "embla-carousel-react": "^8.3.1",
    "embla-carousel-wheel-gestures": "^8.0.1",
    "framer-motion": "^11.11.9",
    "github-slugger": "^2.0.0",
    "google-auth-library": "^9.14.2",
    "google-spreadsheet": "^4.1.4",
    "negotiator": "^1.0.0",
    "next": "15.5.9",
    "next-intl": "^4.3.9",
    "next-mdx-remote": "^5.0.0",
    "react": "19.0.1",
    "react-children-utilities": "^2.10.0",
    "react-dom": "19.0.1",
    "react-error-boundary": "^5.0.0",
    "react-hook-form": "^7.53.1",
    "server-only": "^0.0.1",
    "three": "^0.170.0",
    "three-stdlib": "^2.34.0",
    "ts-pattern": "^5.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "@types/d3-time-format": "^4.0.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/tryghost__content-api": "^1.3.17",
    "@types/unist": "^3.0.3",
    "dotenv": "^17.2.0",
    "embla-carousel": "^8.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.9",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "mdast-util-to-string": "^4.0.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "rehype-parse": "^8.0.4",
    "rehype-pretty-code": "^0.14.0",
    "rehype-react": "^7.2.0",
    "rehype-slug": "^6.0.0",
    "remark-mdx": "^3.1.0",
    "rimraf": "^6.0.1",
    "tailwind-scrollbar-utilities": "^0.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "unified": "^10.1.2",
    "unist-util-visit": "^5.0.0"
  },
  "engines": {
    "node": "20.x"
  },
  "lint-staged": {
    "{.env,src/config/env.{server,client}.mjs}": [
      "pnpm env:check"
    ],
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.12.3",
  "pnpm": {
    "overrides": {
      "axios": "^1.12.0",
      "@babel/runtime": "^7.26.10",
      "brace-expansion": "^2.0.2",
      "form-data": "^4.0.4",
      "glob": "^10.5.0",
      "jws": "^4.0.1",
      "mdast-util-to-hast": "^13.2.1",
      "nanoid": "^3.3.8",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0"
    },
    "patchedDependencies": {
      "@react-three/postprocessing": "patches/@react-three__postprocessing.patch"
    }
  }
}
